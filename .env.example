# Supabase (Project Settings > API Keys). URL은 https://xxx.supabase.co 까지만
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것 (휴대폰 푸시 알림 전송에 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 휴대폰 푸시 알림 (pnpm vapid 로 생성). 비워두면 앱 안 알림만 동작
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:omuandyou@gmail.com
